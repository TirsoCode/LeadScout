# ---------------------------------------------------------------------------
# LeadScout — variables de entorno
#
# NO copies este archivo a `.env.local` a mano si vas a usar Supabase: ejecuta
#   npm run supabase:setup
# que pide las claves a la CLI del proyecto enlazado y escribe `.env.local`
# con permisos 600 (la `service_role` no debe salir nunca de ahí).
#
# IMPORTANTE: la app arranca y funciona TODA sin ninguna de estas variables.
# Cada servicio tiene un fallback local (ver lib/README o AGENTS.md):
#   - Sin OPENROUTER_API_KEY -> analizador heuristico + scoring por keywords
#   - Sin SUPABASE_*         -> auth por cookie + store en JSON local (.data/)
# En cuanto defines las keys, el comportamiento cambia al servicio real sin
# tocar ninguna linea de codigo.
# ---------------------------------------------------------------------------

# --- IA (OpenRouter) -------------------------------------------------------
# Modelos gratuitos: llama-3.1-8b-instruct, google/gemma-2-9b-it, mistral-7b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# Opcional, para las estadisticas publicitarias de openrouter.ai
OPENROUTER_SITE_URL=http://localhost:3000

# --- Supabase (auth + Postgres) -------------------------------------------
# Proyecto enlazado en este entorno: lmxiakrjbeoqgwigmvmx (Leadscoutapp, West EU).
NEXT_PUBLIC_SUPABASE_URL=https://lmxiakrjbeoqgwigmvmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (nunca en el cliente): sin ella la app no puede escribir en la
# BD. El esquema lo crea supabase/migrations/ con `supabase db push --linked`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Reddit ----------------------------------------------------------------
# La API publica no necesita credenciales. Si tienes una app de Reddit puedes
# anadir credenciales de solo-lectura para subir el rate limit.
REDDIT_USER_AGENT=LeadScout/0.1 (by /u/leadscout)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
